# ==============================================================================
# Git Ignore Rules — StockReason Repository
# ==============================================================================

# Python Virtual Environments & Packages
.venv/
.venv*/
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Data Files & Large Parquet Panels
data/
*.parquet
*.csv
*.feather
*.h5
*.sqlite3

# Model Weights & Cache
models/hf_staging/
catboost_info/
mlruns/
.cache/

# Local Environment & Secrets
.env
.env.local
.env.*.local

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local-Only Knowledge Graphs & Agent Hooks
graphify-out/
.agents/

# Documentation & Report Policy: STRICTLY LOCAL ONLY
# Absolute prohibition against committing .md files EXCEPT README.md
*.md
!README.md
!**/README.md
docs/
reports/
artifacts/
*.pdf
*.doc
*.docx
