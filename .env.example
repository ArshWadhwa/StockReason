# ==============================================================================
# StockReason Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEWS & SENTIMENT APIS (Module 2)
# ------------------------------------------------------------------------------
# Finnhub API Key (Used in src/m2_sentiment/fetcher.py for company news)
# Get your free key at: https://finnhub.io/register (60 API calls/min free)
# Note: If left blank, the pipeline automatically falls back to Google News RSS
# which is completely free and requires NO key.
FINNHUB_API_KEY=

# Secondary / Fallback Finnhub API Key (Used automatically if primary hits rate limits or fails)
FINNHUB_API_KEY_FALLBACK=

# Optional: NewsAPI.org Key (for additional news coverage if configured)
# Get a key at: https://newsapi.org/
NEWS_API_KEY=

# ------------------------------------------------------------------------------
# 2. NLP & HUGGING FACE (Module 2 FinBERT)
# ------------------------------------------------------------------------------
# Hugging Face User Access Token (Optional)
# FinBERT (ProsusAI/finbert) is public and downloads automatically without a token.
# Provide a token only if you encounter Hugging Face rate limits or are behind a corporate proxy.
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ------------------------------------------------------------------------------
# 3. BACKEND SERVER CONFIGURATION (Module 4)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vite Dashboard)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
