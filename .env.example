# Hugging Face Access Token (Required for private model repository download/upload)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Hugging Face Model Repository ID (Default: stockreason-models)
HF_REPO_ID=stockreason-models

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8000/api
